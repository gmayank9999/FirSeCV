# Copy to backend/.env and fill in. All are optional — when a key is absent the
# corresponding integration runs in a local mock mode so the server still works.

PORT=3000

# Google Gemini (free tier). When set, real LLM calls replace the mock generator.
GEMINI_API_KEY=
# Optional model override. Default is a current flash-lite alias with generous
# free-tier limits; any generateContent-capable model id works.
GEMINI_MODEL=

# Supabase project. When set, profiles/resumes persist to Postgres + Storage
# instead of the in-memory store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Notion integration. When set, approvals create a row in your tracker database.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# LaTeX engine to shell out to ("tectonic" or "pdflatex"). When absent or not
# installed, approval stores the .tex source and skips PDF compilation.
LATEX_ENGINE=tectonic
